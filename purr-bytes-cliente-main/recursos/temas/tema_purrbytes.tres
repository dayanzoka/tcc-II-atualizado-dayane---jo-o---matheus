[gd_resource type="Theme" load_steps=16 format=3]

[ext_resource type="FontFile" path="res://recursos/fontes/silkscreen_regular.woff" id="1_fonte"]

; Paleta "fofa" amarelo pastel + branco + preto (pedido da Day). A antiga
; paleta laranja/creme (Fase A) foi totalmente substituida aqui -- as cores
; de MECANICA de jogo (aneis dos cachorros, legenda da cifra, estados de
; porta/pacote) NAO vivem neste arquivo e continuam intocadas.
;
; amarelo pastel normal:  #FFD97B
; amarelo pastel hover:   #FFE9AD (mais claro, para dar feedback ao passar o mouse)
; amarelo pastel pressed: #ECBA4D (mais escurinho, para dar feedback de clique)
; preto suave (texto/bordas): #25211B (preto quente, nunca preto puro -- combina
;   mais com o estilo "fofo" do que #000000)
; branco puro e branco cremoso (#FFFBF2) para fundos de campo e paineis

