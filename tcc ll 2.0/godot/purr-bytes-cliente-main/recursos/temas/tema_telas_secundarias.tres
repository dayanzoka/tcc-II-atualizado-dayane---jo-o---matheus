[gd_resource type="Theme" load_steps=15 format=3]

; Tema azul escuro/cinza (pedido da Day). Comecou so no menu principal e
; agora e compartilhado por TODAS as telas de pagina inteira que nao sao
; gameplay: menu_principal, selecao_de_fases, editor_de_fase e
; dashboard_telemetria -- ver ADR 0017 e o adendo do wallpaper nas outras
; telas. Fica isolado deste .tres e nao dentro de tema_purrbytes.tres de
; proposito -- Theme em Godot cascateia pela arvore de nos a partir de onde e
; atribuido, entao basta apontar a raiz de cada uma dessas 4 cenas para este
; arquivo; os OVERLAYS DE JOGO (tela_captura, caixa_puzzle, painel_cifra,
; terminal) continuam de fora -- sao veus translucidos por cima do labirinto
; rodando, nao telas de navegacao, e tests/teste_telas_opacas.gd ja fixa essa
; distincao.

[ext_resource type="FontFile" path="res://recursos/fontes/silkscreen_regular.woff" id="1_fonte"]

