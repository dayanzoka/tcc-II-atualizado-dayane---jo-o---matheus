[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_painel_coluna"]
; Opaco de proposito, nao so estetica: tests/teste_telas_opacas.gd exige que
; todo PanelContainer de uma tela de pagina inteira tenha bg_color.a == 1.0 --
; e a rede que existe desde um bug historico do projeto (texto ilegivel por
; cima de painel translucido). Contra o wallpaper cheio de estrelas, opaco
; tambem le melhor mesmo.
bg_color = Color(0.129, 0.145, 0.188, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.4, 0.443, 0.549, 0.7)
corner_radius_top_left = 14
corner_radius_top_right = 14
corner_radius_bottom_left = 14
corner_radius_bottom_right = 14
content_margin_left = 18.0
content_margin_top = 16.0
content_margin_right = 18.0
content_margin_bottom = 16.0

