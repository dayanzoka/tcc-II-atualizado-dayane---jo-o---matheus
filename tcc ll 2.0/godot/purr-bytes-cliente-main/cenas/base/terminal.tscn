[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://cenas/base/terminal.gd" id="1_terminal"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_opaco"]
bg_color = Color(1, 1, 1, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(1, 0.851, 0.482, 1)
content_margin_left = 6.0
content_margin_top = 5.0
content_margin_right = 6.0
content_margin_bottom = 5.0

[node name="Terminal" type="CanvasLayer"]
layer = 2
process_mode = 3
script = ExtResource("1_terminal")

[node name="Painel" type="PanelContainer" parent="."]
theme_override_styles/panel = SubResource("StyleBoxFlat_opaco")
anchor_top = 0.5
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 6.0
offset_top = 6.0
offset_right = -6.0
offset_bottom = -6.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margem" type="MarginContainer" parent="Painel"]
theme_override_constants/margin_left = 6
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 6
theme_override_constants/margin_bottom = 4

[node name="Coluna" type="VBoxContainer" parent="Painel/Margem"]
theme_override_constants/separation = 4

[node name="Saida" type="RichTextLabel" parent="Painel/Margem/Coluna"]
size_flags_vertical = 3
theme_override_font_sizes/normal_font_size = 8
bbcode_enabled = true
scroll_following = true

[node name="Entrada" type="LineEdit" parent="Painel/Margem/Coluna"]
theme_override_font_sizes/font_size = 8
placeholder_text = "digite um comando e pressione Enter"
caret_blink = true
